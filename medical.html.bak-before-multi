 if(d.form){
  h+='<div class="box"><h3>What do you need?</h3><ul style="list-style:none;display:grid;gap:5px;font-size:13.5px;color:#375775;margin-bottom:12px">'+d.features.map(function(f){return '<li>\u2713 '+esc(f)+'</li>'}).join('')+'</ul>'+
  '<label for="mList">Medicine names or details</label><textarea id="mList" rows="4" maxlength="250" placeholder="e.g. BP tablets for 1 month, or: I will share my prescription on the call"></textarea></div>';
 }
 h+='<div class="how">'+d.how.map(function(x,i){return '<div><b>Step '+(i+1)+'</b>'+esc(x)+'</div>'}).join('')+'</div>';
