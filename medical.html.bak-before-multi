function picked(){return DATA[key].items.filter(function(i){return sel[i.id]})}
function noPick(){var d=DATA[key];return d.mode==='none'&&!d.items.length}
function bar(){
 var bb=document.querySelector('.bar');bb.hidden=soonReq;if(soonReq)return;
 var p=picked(),t=p.reduce(function(a,i){return a+i.price},0),b=$('#bBtn');
 if(noPick()){$('#bSub').textContent='Our team will confirm the price on call';$('#bTot').textContent='';b.disabled=false;b.textContent='Order medicines';return}
 b.textContent='Book now';b.disabled=!p.length;
 $('#bSub').textContent=p.length?(p.length===1?p[0].name:p.length+' selected'):'Nothing selected';
 $('#bTot').textContent=p.length&&t>0?inr(t):'';
}
function render(){tabs();panel();bar()}

$('#tabs').addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;soonReq=false;key=b.dataset.k;sel={};mode='';render()});
$('#panel').addEventListener('click',function(e){if(e.target.id==='vBook'){$('#bBtn').click();return}var b=e.target.closest('.item');if(!b)return;
 var id=b.dataset.i,m=DATA[key].mode;
 if(m==='single'){var was=sel[id];sel={};if(!was)sel[id]=1}else{if(sel[id])delete sel[id];else sel[id]=1}
 panel();bar()});
$('#panel').addEventListener('change',function(e){if(e.target.id==='xMode')mode=e.target.value});
$('#panel').addEventListener('input',function(e){if(e.target.id==='aFrom')route.from=e.target.value;if(e.target.id==='aTo')route.to=e.target.value});

var dlg=$('#dlg'),frm=$('#frm'),msg=$('#mM'),sb=$('#mB'),itemTxt='',detTxt='';
$('#fD').min=new Date().toISOString().slice(0,10);
$('#fP').addEventListener('input',function(){this.value=this.value.replace(/\D/g,'')});
$('#bBtn').addEventListener('click',function(){
 var d=DATA[key],p=picked(),t=p.reduce(function(a,i){return a+i.price},0),parts=[],sm='';
 if(noPick()){
  var l=(($('#mList')||{}).value||'').trim();itemTxt='Medicine order';parts.push('Medicines: '+(l||'to be shared on call'));sm=d.label+(l?': '+l.slice(0,100):'');
 }else{
  var names=p.map(function(i){return i.name});
  itemTxt=p.length===1?p[0].name:p.length+' selected';
  parts.push('Selected: '+names.join(', ')+(t>0?' (Total '+inr(t)+')':''));
  if(d.pay&&!(t>0)){var e2=$('#aErr');if(e2)e2.textContent='Online payment is not available right now. Please try again later.';return}
  if(d.route){var rf=route.from.trim(),rt=route.to.trim();if(!rf||!rt){var er=$('#aErr');if(er){er.textContent='Please enter both pickup and drop locations.';er.scrollIntoView({block:'center'})}return}if(LOC_ON&&!gFail&&((!route.fromLL&&!gNo.aFrom)||(!route.toLL&&!gNo.aTo))){var er2=$('#aErr');if(er2){er2.textContent='Please choose pickup and drop from the suggestion list, or tap "Use my current location" for pickup.';er2.scrollIntoView({block:'center'})}return}parts.push('Pickup: '+rf+' | Drop: '+rt)}
  if(d.extra){mode=($('#xMode')||{}).value||d.extra.opts[0];parts.push('Mode: '+mode)}
  sm=d.label+': '+names.join(', ')+(t>0?' | '+inr(t):'')+(mode&&d.extra?' | '+mode:'')+(d.route?' | '+route.from.trim()+' \u2192 '+route.to.trim():'');
 }
 detTxt=parts.join(' | ');$('#mS').textContent=sm;$('#mT').textContent='Book '+d.label;$('#idBox').hidden=!d.pay;$('#airBox').hidden=!(d.pay&&p[0]&&p[0].id==='airline');var pn=(p[0]&&p[0].id==='airline'&&AMB)?((AMB.items.filter(function(x){return x.id==='airline'})[0]||{}).payNow||t):t;$('#mB').textContent=d.pay?'Pay \u20B9'+pn.toLocaleString('en-IN')+' & Book':'Confirm booking';
 msg.textContent=(d.pay&&AMB&&!AMB.live)?'Demo mode: no real money is charged.':'';msg.className='msg';dlg.showModal()});
$('#mX').addEventListener('click',function(){dlg.close()});
function post(u,b){return fetch(u,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)}).then(function(r){return r.json().then(function(j){if(!r.ok)throw new Error(j.error||'Something went wrong.');return j})})}
function say(t,c){msg.className='msg '+(c||'');msg.textContent=t}
function shrink(f){return new Promise(function(ok,no){var r=new FileReader();r.onload=function(){var m=new Image();m.onload=function(){var z=Math.min(1,1400/Math.max(m.width,m.height)),c=document.createElement('canvas');c.width=m.width*z;c.height=m.height*z;c.getContext('2d').drawImage(m,0,0,c.width,c.height);ok(c.toDataURL('image/jpeg',.75))};m.onerror=no;m.src=r.result};r.onerror=no;r.readAsDataURL(f)})}
function paid(j){if(j.invoice){try{var iv=JSON.stringify(j.invoice);sessionStorage.setItem('gth_invoice',iv);localStorage.setItem('gth_invoice',iv)}catch(e){}location.href='ambulance-invoice.html';return}
msg.className='msg ok';msg.textContent=j.message+' Booking ID: '+j.id+'. ';var a=document.createElement('a');a.href='track.html';a.textContent='Track your booking';a.style.color='#087cf2';msg.appendChild(a);frm.reset();sb.disabled=false}
function payFlow(){
 var f=$('#fI').files[0],pk=picked()[0];
 if(!$('#fC').checked)return say('Please tick the consent box to continue.','err');
 if(!f)return say('Please upload your Aadhaar card photo.','err');
 var isA=pk.id==='airline',air=null;
 if(isA){var ap=$('#aAp').value.replace(/\D/g,'').slice(-10);
  if(!(+$('#aW').value>0)||$('#aDx').value.trim().length<3||$('#aAn').value.trim().length<2||ap.length!==10||$('#aDh').value.trim().length<2)return say('Please fill all flight transfer details.','err');
  if(!$('#aFit').files[0]||!$('#aRep').files[0])return say('Please upload the fitness certificate and medical reports.','err');
  air={weight:+$('#aW').value,dx:$('#aDx').value.trim(),mode:$('#aSt').value,oxygen:$('#aOx').value,infection:$('#aIn').value,attendant:$('#aAn').value.trim(),attendantPhone:ap,dropHospital:$('#aDh').value.trim()}}
 sb.disabled=true;say('Please wait...');
 Promise.all([shrink(f)].concat(isA?[shrink($('#aFit').files[0]),shrink($('#aRep').files[0]),$('#aBed').files[0]?shrink($('#aBed').files[0]):Promise.resolve('')]:[])).then(function(im){var img=im[0];return post('/api/ambulance/start',{air:isA?Object.assign({},air,{docs:{fit:im[1],rep:im[2],bed:im[3]}}):null,option:pk.id,name:$('#fN').value.trim(),phone:$('#fP').value,age:$('#fG').value,address:$('#fA').value.trim(),date:$('#fD').value,slot:$('#fS').value,pickup:route.from.trim(),drop:route.to.trim(),pickupLL:route.fromLL||null,dropLL:route.toLL||null,addressLL:gAddrLL||null,note:$('#fT').value.trim(),consent:true,idProof:img})}).then(function(s){
  if(s.demo)return post('/api/ambulance/confirm',{id:s.id}).then(paid);
  return new Promise(function(ok){var sc=document.createElement('script');sc.src='https://checkout.razorpay.com/v1/checkout.js';
   sc.onload=function(){new Razorpay({key:s.keyId,amount:s.amount*100,currency:'INR',order_id:s.orderId,name:'Ghar to Health',description:'Ambulance booking',prefill:{name:$('#fN').value,contact:$('#fP').value},theme:{color:'#087cf2'},
    handler:function(r){ok(post('/api/ambulance/confirm',{id:s.id,razorpay_payment_id:r.razorpay_payment_id,razorpay_order_id:r.razorpay_order_id,razorpay_signature:r.razorpay_signature}).then(paid))},
    modal:{ondismiss:function(){say('Payment cancelled. Your ambulance is not booked yet.','err');sb.disabled=false}}}).open()};
   sc.onerror=function(){say('Cannot open the payment page. Please try again.','err');sb.disabled=false};document.head.appendChild(sc)})
 }).catch(function(x){say(x&&x.message?x.message:'Something went wrong. Please try again.','err');sb.disabled=false})}
frm.addEventListener('submit',function(e){
 e.preventDefault();if(DATA[key].pay){payFlow();return}
 var extra=$('#fT').value.trim();
 var data={service:DATA[key].label,item:itemTxt,name:$('#fN').value.trim(),phone:$('#fP').value,age:$('#fG').value,
  address:$('#fA').value.trim(),date:$('#fD').value,slot:$('#fS').value,details:(detTxt+(extra?' | Note: '+extra:'')).slice(0,400),consent:$('#fC').checked};
 if(!data.consent){msg.className='msg err';msg.textContent='Please tick the consent box to continue.';return}
 sb.disabled=true;msg.className='msg';msg.textContent='Sending...';
 fetch('/api/medical-bookings',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)})
 .then(function(r){return r.json().then(function(j){return{ok:r.ok,j:j}})})
 .then(function(x){
  if(x.ok){msg.className='msg ok';msg.textContent=x.j.message+' Booking ID: '+x.j.id+'. ';
   var a=document.createElement('a');a.href='track.html';a.textContent='Track your booking';a.style.color='#087cf2';msg.appendChild(a);frm.reset()}
  else{msg.className='msg err';msg.textContent=x.j.error||'Something went wrong.'}})
 .catch(function(){msg.className='msg err';msg.textContent='Cannot reach the server. Please try again.'})
 .then(function(){sb.disabled=false});
});

/* ===== Free location search (OpenStreetMap / Photon): suggestions + current location. No API key needed ===== */
var LOC_ON=true,gAddrLL=null,gTimer=null,gFail=false,gNo={},gSeq={};
function gBtn(id){return '<button type="button" class="gloc" data-g="'+id+'">📍 Use my current location</button>'}
function gLabel(p){var a=[p.name,[p.street,p.housenumber].filter(Boolean).join(' '),p.district||p.locality,p.city,p.state,p.postcode],o=[];
 a.forEach(function(x){if(x&&o.indexOf(x)<0)o.push(x)});return o.join(', ')}
function gBox(inp){var p=inp.parentNode;p.classList.add('gwrap');var b=p.querySelector('.gdrop[data-for="'+inp.id+'"]');
 if(!b){b=document.createElement('div');b.className='gdrop';b.setAttribute('data-for',inp.id);p.appendChild(b)}
 b.style.top=(inp.offsetTop+inp.offsetHeight+2)+'px';b.style.left=inp.offsetLeft+'px';b.style.width=inp.offsetWidth+'px';return b}
function gApply(id,text,ll){var inp=document.getElementById(id);if(!inp)return;inp.value=text;gNo[id]=false;
 if(id==='aFrom'){route.from=text;route.fromLL=ll}else if(id==='aTo'){route.to=text;route.toLL=ll}else if(id==='fA'){gAddrLL=ll}
 var b=inp.parentNode.querySelector('.gdrop[data-for="'+id+'"]');if(b)b.innerHTML='';var er=$('#aErr');if(er)er.textContent=''}
function gSuggest(inp){clearTimeout(gTimer);var v=inp.value.trim(),b=gBox(inp),id=inp.id;gSeq[id]=(gSeq[id]||0)+1;var my=gSeq[id];
 if(v.length<3){b.innerHTML='';return}
 gTimer=setTimeout(function(){
  fetch('https://photon.komoot.io/api/?lang=en&limit=10&lat=22.5&lon=79&q='+encodeURIComponent(v)).then(function(r){if(!r.ok)throw 0;return r.json()}).then(function(j){
   if(my!==gSeq[id])return;gFail=false;
   var list=(j.features||[]).filter(function(f){return f.properties&&f.properties.countrycode==='IN'&&f.geometry&&f.geometry.coordinates}).slice(0,5)
    .map(function(f){return{t:gLabel(f.properties),ll:{lat:f.geometry.coordinates[1],lng:f.geometry.coordinates[0]}}}).filter(function(x){return x.t});
   b._list=list;gNo[id]=!list.length;
   b.innerHTML=list.length?list.map(function(s,i){return '<div class="gi" data-i="'+i+'">'+esc(s.t)+'</div>'}).join('')+'<div class="gpw">© OpenStreetMap contributors</div>':'<div class="gpw">No match found. You can type the place manually.</div>'
  }).catch(function(){gFail=true})},500)}
document.addEventListener('input',function(e){var id=e.target.id;
 if(id==='aFrom'){route.fromLL=null;gSuggest(e.target)}else if(id==='aTo'){route.toLL=null;gSuggest(e.target)}else if(id==='fA'){gAddrLL=null;gSuggest(e.target)}});
document.addEventListener('mousedown',function(e){var it=e.target.closest&&e.target.closest('.gi');
 if(!it){document.querySelectorAll('.gdrop').forEach(function(x){x.innerHTML=''});return}
 e.preventDefault();var box=it.parentNode,s=box._list&&box._list[+it.dataset.i];if(s)gApply(box.getAttribute('data-for'),s.t,s.ll)});
document.addEventListener('click',function(e){var b=e.target.closest&&e.target.closest('.gloc');if(!b)return;e.preventDefault();gHere(b)});
function gHere(btn){var id=btn.dataset.g,old=btn.textContent;
 if(!navigator.geolocation){alert('Your browser does not support location. Please type the place and choose it from the list.');return}
 btn.disabled=true;btn.textContent='Finding your location...';var done=function(){btn.disabled=false;btn.textContent=old};
 navigator.geolocation.getCurrentPosition(function(p){var ll={lat:p.coords.latitude,lng:p.coords.longitude},fb=ll.lat.toFixed(5)+', '+ll.lng.toFixed(5);
  fetch('https://photon.komoot.io/reverse?lang=en&lat='+ll.lat+'&lon='+ll.lng).then(function(r){return r.json()}).then(function(j){
   var f=j.features&&j.features[0];gApply(id,(f&&f.properties&&gLabel(f.properties))||fb,ll)}).catch(function(){gApply(id,fb,ll)}).then(done)},
 function(){done();alert('Could not get your location. Please allow location access in the browser (needs https), or type the place and choose it from the list.')},
 {enableHighAccuracy:true,timeout:15000,maximumAge:0})}
(function(){var fAb=document.getElementById('fAloc');if(fAb)fAb.hidden=false})();
var AMB=null;fetch('/api/ambulance/options').then(function(r){return r.json()}).then(function(o){AMB=o;o.items.forEach(function(x){var it=DATA.ambulance.items.filter(function(i){return i.id===x.id})[0];if(it){it.price=x.advance;it.pl='Total '}});render()}).catch(function(){});
render();
})();
