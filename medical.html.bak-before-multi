 if(d.route){h+='<div class="box"><h3>Pickup &amp; drop</h3><div class="two"><div><label for="aFrom">Pickup location (search and select)</label><input id="aFrom" maxlength="80" value="'+esc(route.from)+'" placeholder="Search pickup location" autocomplete="off">'+gBtn('aFrom')+'</div><div><label for="aTo">Drop location (search and select)</label><input id="aTo" maxlength="80" value="'+esc(route.to)+'" placeholder="Search drop location" autocomplete="off"></div></div><p class="msg err" id="aErr"></p></div>'}
