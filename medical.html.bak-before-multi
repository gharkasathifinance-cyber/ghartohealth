<label for="fA">Address</label><textarea id="fA" name="address" rows="2" required autocomplete="off"></textarea><button type="button" class="gloc" data-g="fA" id="fAloc" hidden>📍 Use my current location</button>
<div class="two"><div><label for="fD">Preferred date</label><input id="fD" name="date" type="date" required></div>
<div><label for="fS">Time slot</label><select id="fS" name="slot"><option value="Morning (9-12)">Morning (9-12)</option><option value="Afternoon (12-4)">Afternoon (12-4)</option><option value="Evening (4-8)">Evening (4-8)</option></select></div></div>
<label for="fT">Anything we should know? (optional)</label><textarea id="fT" rows="2" maxlength="200"></textarea>
<div id="idBox" hidden><label for="fI">Aadhaar card photo (compulsory)</label><input id="fI" type="file" accept="image/*"><p class="note" style="margin-top:4px">Used only to verify the patient or attendant. Seen only by our team.</p></div>
<div id="airBox" hidden><p class="note" style="margin:10px 0 0"><b>Flight transfer details</b> (needed by the airline)</p>
<label for="aW">Patient weight (kg)</label><input id="aW" type="number" min="1" max="250">
<label for="aDx">Medical condition / diagnosis</label><textarea id="aDx" rows="2" maxlength="200"></textarea>
<label for="aSt">Patient can</label><select id="aSt"><option value="stretcher">Only lie down (stretcher)</option><option value="sit">Sit in a seat</option></select>
